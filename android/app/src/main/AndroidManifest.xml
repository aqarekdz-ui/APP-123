<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- =================================================================== -->
    <!-- صلاحيات التنبيهات والمنبهات الدقيقة (Alarms & Notifications)           -->
    <!-- =================================================================== -->

    <!-- إلزامي (Android 13+): إظهار الإشعارات والمنبهات للمستخدم في شريط النظام -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- إلزامي (Android 12+): جدولة منبهات دقيقة في الوقت المحدد بالثانية عبر AlarmManager -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- إلزامي: إعادة تسجيل المنبهات غير المنتهية فور إقلاع الهاتف أو إعادة تشغيله -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- إلزامي للمنبه الصوتي: إيقاظ المعالج والشاشة مؤقتاً عند حلول موعد المنبه الحرج -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- إلزامي: تشغيل الاهتزاز مع رنين المنبه لتنبيه المستخدم -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android 13+: يُمنح تلقائياً عند التثبيت (استعمال شخصي، خارج Play) فتتجدول التذكيرات بدقة بدون خطوة يدوية -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Android 11+: رؤية محركات TTS المثبتة (Google TTS) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.google.android.tts" />
    </queries>

    <application
        android:name=".DaniApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- اختصارات الأيقونة (ضغطة طويلة) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- استقبال نص/رابط من التطبيقات الأخرى (مشاركة إلى DANI) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- مستقبل تشغيل المنبه عند حلول وقته المحدد -->
        <receiver
            android:name=".core.alarm.AlarmReceiver"
            android:exported="false" />

        <!-- مستقبل أزرار التفاعل داخل الإشعار ("تم الإنجاز" و "تأجيل 30 دقيقة") -->
        <receiver
            android:name=".core.alarm.ReminderActionReceiver"
            android:exported="false" />

        <!-- مستقبل استعادة المنبهات بعد إعادة تشغيل الهاتف -->
        <receiver
            android:name=".core.alarm.BootCompletedReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- الملخص الصباحي اليومي -->
        <receiver
            android:name=".core.digest.MorningDigestReceiver"
            android:exported="false" />

        <!-- تذكير الأدوية -->
        <receiver
            android:name=".core.meds.MedReceiver"
            android:exported="false" />

        <!-- مشاركة صور الفواتير مع الكاميرا -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- مناسبات وأعياد ميلاد -->
        <receiver
            android:name=".core.events.EventReceiver"
            android:exported="false" />

        <!-- مؤقت التركيز (Pomodoro) -->
        <receiver
            android:name=".core.focus.PomodoroReceiver"
            android:exported="false" />

        <!-- ودجت المهام القادمة -->
        <receiver
            android:name=".widget.TaskWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dani_widget_info" />
        </receiver>

        <!-- ودجت اليوم: عادات + جرعات -->
        <receiver
            android:name=".widget.DailyWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dani_daily_widget_info" />
        </receiver>

    </application>

</manifest>
